@@ -0,0 +1,448 @@
+// Copyright 2026 PokemonSunNative contributors
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+
+#include "common/logging/log.h"
+#include "core/memory.h"
+#include "video_core/frame_interpolator.h"
+#include "video_core/gpu.h"
+#include "video_core/pica/pica_core.h"
+#include "video_core/rasterizer_interface.h"
+#include "video_core/renderer_base.h"
+
+namespace VideoCore {
+
+namespace {
+
+double display_rate = 0.0;
+
+// Frames further apart than this (in emulated time) are not blended: the game was loading or
+// paused, and the two frames are unrelated.
+constexpr u64 MAX_BLEND_GAP = 4 * FRAME_TICKS;
+
+u64 Mix(u64 h, u64 v) {
+    h ^= v + 0x9E3779B97F4A7C15ull + (h << 6) + (h >> 2);
+    return h;
+}
+
+/// Whether a uniform component changing from `a` to `b` between two game frames should be
+/// blended. Vertex-shader uniforms are mostly 3x4 matrices stored as rows: x, y, z hold rotation
+/// and scale, w holds translation, which can legitimately move a lot in one frame. Whole numbers
+/// that change (counters, indices) switch over instead of being blended.
+bool Blendable(float a, float b, u32 component) {
+    if (!std::isfinite(a) || !std::isfinite(b))
+        return false;
+    const float magnitude = std::max(std::fabs(a), std::fabs(b));
+    if (a == std::floor(a) && b == std::floor(b) && magnitude < 1024.0f)
+        return false;
+    const float limit = component == 3 ? 4.0f + magnitude : 0.75f + 0.35f * magnitude;
+    return std::fabs(a - b) <= limit;
+}
+
+/// A rotation-like component (|value| <= ~1) jumped: the object or the camera turned too far in
+/// one frame to be motion (a cut).
+bool RotationJump(float a, float b, u32 component) {
+    return component != 3 && std::max(std::fabs(a), std::fabs(b)) <= 1.5f &&
+           std::fabs(a - b) > 0.75f;
+}
+
+} // namespace
+
+void SetDisplayRate(double fps) {
+    display_rate = fps;
+}
+
+double GetDisplayRate() {
+    return display_rate;
+}
+
+void FrameInterpolator::Frame::Clear() {
+    start_state.clear();
+    ops.clear();
+    draws.clear();
+    ranges.clear();
+    segments.clear();
+    blob.clear();
+    transfer_outputs.clear();
+    end_ticks = 0;
+    started = false;
+}
+
+FrameInterpolator::FrameInterpolator(Pica::PicaCore& pica_, Memory::MemorySystem& memory_)
+    : pica{pica_}, memory{memory_} {}
+
+FrameInterpolator::~FrameInterpolator() = default;
+
+void FrameInterpolator::Reset() {
+    recording.Clear();
+    for (Frame& f : frames) {
+        f.Clear();
+        f.serial = 0;
+    }
+    match.clear();
+    blend.clear();
+    cut = false;
+    last_serial = 0;
+    last_t = -1.0f;
+}
+
+u32 FrameInterpolator::AddBlob(const u8* data, u32 size) {
+    const u32 offset = static_cast<u32>(recording.blob.size());
+    recording.blob.insert(recording.blob.end(), data, data + size);
+    return offset;
+}
+
+void FrameInterpolator::BeginFrameIfNeeded() {
+    if (recording.started)
+        return;
+    recording.started = true;
+    recording.start_state = pica.SaveState();
+}
+
+void FrameInterpolator::RecordFill(u32 index, const Pica::MemoryFillConfig& config) {
+    BeginFrameIfNeeded();
+    Op op{Op::Type::Fill, index, 0, 0, {}};
+    std::memcpy(op.config.data(), &config, sizeof(config));
+    recording.ops.push_back(op);
+}
+
+void FrameInterpolator::RecordTransfer(const Pica::DisplayTransferConfig& config) {
+    BeginFrameIfNeeded();
+    Op op{Op::Type::Transfer, 0, 0, 0, {}};
+    std::memcpy(op.config.data(), &config, sizeof(config));
+    recording.ops.push_back(op);
+    if (!config.is_texture_copy)
+        recording.transfer_outputs.push_back(config.GetPhysicalOutputAddress());
+}
+
+void FrameInterpolator::RecordCmdList(PAddr addr, u32 size) {
+    BeginFrameIfNeeded();
+    recording.ops.push_back(Op{Op::Type::CmdList, 0, addr, size, {}});
+}
+
+void FrameInterpolator::RecordWords(PAddr addr, const u8* data, u32 size) {
+    if (!data)
+        return;
+    recording.segments.push_back(Segment{addr, size, AddBlob(data, size)});
+}
+
+void FrameInterpolator::RecordDraw(bool is_indexed) {
+    const auto& regs = pica.regs.internal;
+    const auto& pipeline = regs.pipeline;
+    const PAddr base = pipeline.vertex_attributes.GetPhysicalBaseAddress();
+
+    Draw draw{};
+    draw.first_range = static_cast<u32>(recording.ranges.size());
+
+    auto snapshot = [&](PAddr addr, u32 size) {
+        const u8* p = memory.GetPhysicalPointer(addr);
+        if (!p || size == 0 || size > 16 * 1024 * 1024)
+            return;
+        recording.ranges.push_back(Range{addr, size, AddBlob(p, size)});
+    };
+
+    u32 vmin, vmax;
+    if (is_indexed) {
+        const PAddr index_addr = base + pipeline.index_array.offset;
+        const bool u16_indices = pipeline.index_array.format != 0;
+        const u32 count = pipeline.num_vertices;
+        const u8* p = memory.GetPhysicalPointer(index_addr);
+        if (!p || count == 0) {
+            vmin = vmax = 0;
+        } else {
+            vmin = 0xFFFF;
+            vmax = 0;
+            for (u32 i = 0; i < count; i++) {
+                u32 v;
+                if (u16_indices) {
+                    u16 x;
+                    std::memcpy(&x, p + 2 * i, 2);
+                    v = x;
+                } else {
+                    v = p[i];
+                }
+                vmin = std::min(vmin, v);
+                vmax = std::max(vmax, v);
+            }
+            snapshot(index_addr, count * (u16_indices ? 2 : 1));
+        }
+    } else {
+        vmin = pipeline.vertex_offset;
+        vmax = pipeline.vertex_offset + std::max<u32>(pipeline.num_vertices, 1) - 1;
+    }
+
+    u64 key = Mix(0, base);
+    key = Mix(key, is_indexed ? pipeline.index_array.offset : pipeline.vertex_offset);
+    key = Mix(key, pipeline.num_vertices);
+    key = Mix(key, regs.vs.main_offset);
+    key = Mix(key, regs.texturing.texture0.address);
+    key = Mix(key, regs.framebuffer.framebuffer.color_buffer_address);
+    for (const auto& loader : pipeline.vertex_attributes.attribute_loaders) {
+        if (loader.component_count == 0)
+            continue;
+        key = Mix(key, loader.data_offset);
+        const u32 stride = loader.byte_count;
+        if (vmax >= vmin && stride != 0)
+            snapshot(base + loader.data_offset + vmin * stride, (vmax - vmin + 1) * stride);
+    }
+    draw.key = key;
+    draw.f = pica.vs_setup.uniforms.f;
+    draw.num_ranges = static_cast<u32>(recording.ranges.size()) - draw.first_range;
+    recording.draws.push_back(draw);
+}
+
+void FrameInterpolator::EndFrame(u64 ticks) {
+    if (!recording.started)
+        return;
+    // Debugging aid: PSN_INTERP_FREEZE=<file> keeps the current pair of frames while the file
+    // exists, and PSN_INTERP_T=<t> forces the blend factor.
+    if (const char* freeze = std::getenv("PSN_INTERP_FREEZE"); freeze && frames[0].serial) {
+        if (std::FILE* fp = std::fopen(freeze, "r")) {
+            std::fclose(fp);
+            recording.Clear();
+            return;
+        }
+    }
+    recording.end_ticks = ticks;
+    recording.framebuffer_config = {pica.regs.framebuffer_config[0],
+                                    pica.regs.framebuffer_config[1]};
+    recording.regs_lcd = pica.regs_lcd;
+    recording.serial = next_serial++;
+    std::swap(frames[0], frames[1]);
+    std::swap(frames[1], recording);
+    recording.Clear();
+    MatchFrames();
+}
+
+void FrameInterpolator::MatchFrames() {
+    const Frame& prev = frames[0];
+    const Frame& cur = frames[1];
+    match.assign(cur.draws.size(), -1);
+    blend.assign(cur.draws.size(), Blend::Same);
+    cut = false;
+    if (!prev.serial || cur.end_ticks <= prev.end_ticks ||
+        cur.end_ticks - prev.end_ticks > MAX_BLEND_GAP) {
+        return;
+    }
+
+    // The k-th draw with a given key in this frame matches the k-th one in the previous frame
+    std::unordered_map<u64, std::vector<u32>> by_key;
+    for (u32 i = 0; i < prev.draws.size(); i++)
+        by_key[prev.draws[i].key].push_back(i);
+    std::unordered_map<u64, u32> used;
+
+    u32 moving = 0, turned = 0;
+    for (u32 i = 0; i < cur.draws.size(); i++) {
+        const Draw& d = cur.draws[i];
+        auto it = by_key.find(d.key);
+        if (it == by_key.end())
+            continue;
+        u32& n = used[d.key];
+        if (n >= it->second.size())
+            continue;
+        const Draw& p = prev.draws[it->second[n++]];
+        match[i] = static_cast<s32>(&p - prev.draws.data());
+        bool same = true, jumped = false;
+        for (u32 r = 0; r < 96; r++) {
+            for (u32 c = 0; c < 4; c++) {
+                const float a = p.f[r][c].ToFloat32(), b = d.f[r][c].ToFloat32();
+                if (a == b)
+                    continue;
+                same = false;
+                jumped |= RotationJump(a, b, c);
+            }
+        }
+        if (same)
+            continue;
+        blend[i] = Blend::Lerp;
+        moving++;
+        turned += jumped;
+    }
+    // Most moving things jumped at once: a camera cut or a scene change, don't blend anything
+    cut = moving >= 4 && turned * 2 > moving;
+}
+
+const u8* FrameInterpolator::ReplayWords(PAddr addr, u32 size) {
+    // Segments are consumed in the order the game's lists were read
+    if (!replaying || replay_segment >= replaying->segments.size())
+        return nullptr;
+    const Segment& s = replaying->segments[replay_segment];
+    if (s.addr != addr || s.size != size)
+        return nullptr;
+    replay_segment++;
+    return replaying->blob.data() + s.blob_offset;
+}
+
+void FrameInterpolator::BeginReplayDraw() {
+    if (!replaying || replay_draw >= replaying->draws.size())
+        return;
+    const u32 index = replay_draw;
+    const Draw& d = replaying->draws[index];
+
+    // Put the vertex and index data back as they were when the game drew this
+    for (u32 r = d.first_range; r < d.first_range + d.num_ranges; r++) {
+        const Range& range = replaying->ranges[r];
+        u8* live = memory.GetPhysicalPointer(range.addr);
+        const u8* recorded = replaying->blob.data() + range.blob_offset;
+        if (!live || std::memcmp(live, recorded, range.size) == 0)
+            continue;
+        overlay.emplace_back(live, std::vector<u8>(live, live + range.size));
+        std::memcpy(live, recorded, range.size);
+    }
+
+    // Blend the uniforms (matrices) with the matching draw of the previous frame
+    if (replaying == &frames[1] && !cut && replay_t < 1.0f && index < match.size() &&
+        match[index] >= 0 && blend[index] == Blend::Lerp) {
+        const Draw& p = frames[0].draws[match[index]];
+        auto& f = pica.vs_setup.uniforms.f;
+        saved_uniforms = f;
+        const float t = replay_t;
+        for (u32 r = 0; r < 96; r++) {
+            for (u32 c = 0; c < 4; c++) {
+                const float a = p.f[r][c].ToFloat32(), b = d.f[r][c].ToFloat32();
+                if (a != b && Blendable(a, b, c))
+                    f[r][c] = Pica::f24::FromFloat32(a + (b - a) * t);
+            }
+        }
+        pica.vs_setup.uniforms_dirty = true;
+        uniforms_overridden = true;
+    }
+}
+
+void FrameInterpolator::EndReplayDraw() {
+    if (!replaying)
+        return;
+    for (auto it = overlay.rbegin(); it != overlay.rend(); ++it)
+        std::memcpy(it->first, it->second.data(), it->second.size());
+    overlay.clear();
+    if (uniforms_overridden) {
+        pica.vs_setup.uniforms.f = saved_uniforms;
+        pica.vs_setup.uniforms_dirty = true;
+        uniforms_overridden = false;
+    }
+    replay_draw++;
+}
+
+void FrameInterpolator::Replay(const Frame& frame, float t, RasterizerInterface& rasterizer) {
+    replaying = &frame;
+    replay_t = t;
+    replay_draw = 0;
+    replay_segment = 0;
+    pica.LoadState(frame.start_state);
+    pica.SetReplayMode(this);
+    for (const Op& op : frame.ops) {
+        switch (op.type) {
+        case Op::Type::Fill: {
+            auto& config = pica.regs.memory_fill_config[op.index];
+            std::memcpy(&config, op.config.data(), sizeof(config));
+            if (config.trigger) {
+                const bool ok = rasterizer.AccelerateFill(config);
+                if (std::getenv("PSN_INTERP_DEBUG") && (debug_counter % 60) == 1)
+                    LOG_INFO(HW_GPU, "replay fill {:08X}-{:08X} ok {}", config.GetStartAddress(),
+                             config.GetEndAddress(), ok);
+            }
+            config.trigger.Assign(0);
+            config.finished.Assign(1);
+            break;
+        }
+        case Op::Type::Transfer: {
+            auto& config = pica.regs.display_transfer_config;
+            std::memcpy(&config, op.config.data(), sizeof(config));
+            bool ok;
+            if (config.is_texture_copy)
+                ok = rasterizer.AccelerateTextureCopy(config);
+            else
+                ok = rasterizer.AccelerateDisplayTransfer(config);
+            if (std::getenv("PSN_INTERP_DEBUG") && (debug_counter % 60) == 1)
+                LOG_INFO(HW_GPU, "replay transfer {:08X} -> {:08X} ok {}",
+                         config.GetPhysicalInputAddress(), config.GetPhysicalOutputAddress(), ok);
+            config.trigger.Assign(0);
+            break;
+        }
+        case Op::Type::CmdList:
+            pica.ProcessCmdList(op.addr, op.size, false);
+            break;
+        }
+    }
+    pica.SetReplayMode(nullptr);
+    if (std::getenv("PSN_INTERP_DEBUG") && (debug_counter % 60) == 1)
+        LOG_INFO(HW_GPU, "replay: {} of {} draws, {} of {} segments", replay_draw,
+                 frame.draws.size(), replay_segment, frame.segments.size());
+    replaying = nullptr;
+}
+
+void FrameInterpolator::Present(u64 now_ticks, RasterizerInterface& rasterizer,
+                                RendererBase& renderer) {
+    const Frame& cur = frames[1];
+    if (!cur.serial) {
+        renderer.SwapBuffers();
+        return;
+    }
+
+    float t = 1.0f;
+    const Frame& prev = frames[0];
+    if (prev.serial && cur.end_ticks > prev.end_ticks &&
+        cur.end_ticks - prev.end_ticks <= MAX_BLEND_GAP && !cut) {
+        const double span = static_cast<double>(cur.end_ticks - prev.end_ticks);
+        const double since = now_ticks > cur.end_ticks
+                                 ? static_cast<double>(now_ticks - cur.end_ticks)
+                                 : 0.0;
+        t = static_cast<float>(std::clamp(since / span, 0.0, 1.0));
+    }
+
+    if (std::getenv("PSN_INTERP_DEBUG") && (debug_counter++ % 60) == 0) {
+        u32 matched = 0, lerp = 0;
+        for (u32 i = 0; i < match.size(); i++) {
+            matched += match[i] >= 0;
+            lerp += blend[i] == Blend::Lerp;
+        }
+        LOG_INFO(HW_GPU,
+                 "interp: frame {} draws {} matched {} blended {} t {:.2f} cut {} blob {} KB, "
+                 "replay {} us",
+                 cur.serial, cur.draws.size(), matched, lerp, t, cut, cur.blob.size() / 1024,
+                 replays ? replay_us / replays : 0);
+        replay_us = replays = 0;
+    }
+    if (const char* forced = std::getenv("PSN_INTERP_T")) {
+        if (std::FILE* fp = std::fopen(forced, "r")) {
+            float v = 1.0f;
+            if (std::fscanf(fp, "%f", &v) == 1)
+                t = std::clamp(v, 0.0f, 1.0f);
+            std::fclose(fp);
+        }
+    }
+    const std::string live = pica.SaveState();
+    if (cur.serial != last_serial || t != last_t) {
+        const auto start = std::chrono::steady_clock::now();
+        Replay(cur, t, rasterizer);
+        replay_us += std::chrono::duration_cast<std::chrono::microseconds>(
+                         std::chrono::steady_clock::now() - start)
+                         .count();
+        replays++;
+        last_serial = cur.serial;
+        last_t = t;
+    }
+
+    // Show the screens this frame wrote, whatever the game has swapped to since
+    pica.regs_lcd = cur.regs_lcd;
+    for (u32 screen = 0; screen < 2; screen++) {
+        auto fb = cur.framebuffer_config[screen];
+        for (const PAddr out : cur.transfer_outputs) {
+            if (out == fb.address_left1)
+                fb.active_fb = 0;
+            else if (out == fb.address_left2)
+                fb.active_fb = 1;
+        }
+        pica.regs.framebuffer_config[screen] = fb;
+    }
+    renderer.SwapBuffers();
+    pica.LoadState(live);
+}
