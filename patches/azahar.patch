+void GPU::UpdateInterpolation() {
+    // Called between game frames, when switching cannot split a frame
+    const bool want = GetDisplayRate() > 0.0;
+    if (want && !impl->interp_active) {
+        LOG_INFO(HW_GPU, "Frame interpolation on ({} FPS)", GetDisplayRate());
+        impl->interp->Reset();
+        impl->pica.SetRecorder(impl->interp.get());
+        impl->interp_active = true;
+        impl->display_error = 0.0;
+        if (!impl->display_scheduled) {
+            impl->display_scheduled = true;
+            impl->timing.ScheduleEvent(1, impl->display_event);
+        }
+    } else if (!want && impl->interp_active) {
+        LOG_INFO(HW_GPU, "Frame interpolation off");
+        impl->pica.SetRecorder(nullptr);
+        impl->interp_active = false;
+    }
+}
+
+void GPU::DisplayCallback(s64 cycles_late) {
+    if (!impl->interp_active) {
+        impl->display_scheduled = false;
+        return;
+    }
+    // The rate can be 0 until the next game frame turns interpolation off: keep the last one
+    const double rate = GetDisplayRate();
+    if (rate > 0.0) {
+        impl->display_interval = static_cast<double>(BASE_CLOCK_RATE_ARM11) / rate;
+    } else if (impl->display_interval <= 0.0) {
+        impl->display_interval = static_cast<double>(FRAME_TICKS);
+    }
+    impl->interp->Present(static_cast<u64>(impl->timing.GetTicks()), *impl->rasterizer,
+                          *impl->renderer);
+    // The display rate is in real time: when the game runs faster or slower than normal
+    // (fast-forward), present proportionally fewer or more frames per emulated second.
+    const double limit = Settings::GetFrameLimit();
+    const double speed = limit <= 0.0 ? 4.0 : limit / 100.0;
+    // Keep the long-run rate exact although the interval is not a whole number of ticks
+    impl->display_error += impl->display_interval * speed;
+    const s64 next = static_cast<s64>(impl->display_error);
+    impl->display_error -= static_cast<double>(next);
+    impl->timing.ScheduleEvent(std::max<s64>(next - cycles_late, 1), impl->display_event);
+}
