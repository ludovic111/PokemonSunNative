+    /// When set, System::Init creates CPU cores with this instead of dynarmic / dyncom.
+    std::function<std::shared_ptr<ARM_Interface>(System&, Memory::MemorySystem&, u32 core_id,
+                                                 std::shared_ptr<Timing::Timer>)>
+        factory;
+    /// Called after ldr:ro has loaded and relocated a CRO module.
+    std::function<void(const std::string& name, VAddr address, u32 size)> on_cro_loaded;
+    /// Called before ldr:ro unloads a CRO module.
+    std::function<void(const std::string& name, VAddr address)> on_cro_unloaded;
+};
+
+ExternalCpu& GetExternalCpu();
+
+} // namespace Core
