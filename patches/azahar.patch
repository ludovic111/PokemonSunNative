+// Copyright 2026 PokemonSunNative contributors
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+// Display-rate frame interpolation.
+//
+// Games render at a fixed rate (Pokémon Sun: 30 FPS). In interpolation mode the GPU work of each
+// game frame is recorded instead of being executed: command lists (with the vertex and index data
+// they read), memory fills and display transfers. At every display refresh the last complete frame
+// is replayed through the rasterizer, with each draw's vertex-shader uniforms (its matrices)
+// blended between that frame and the one before it. Draws are matched between frames by what they
+// draw (vertex buffers, shader, texture, render target). The game's logic and timing are untouched;
+// what is shown lags the game by at most one of its frames.
+
+#pragma once
+
+#include <array>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include "common/common_types.h"
+#include "common/vector_math.h"
+#include "video_core/pica/regs_external.h"
+#include "video_core/pica/regs_lcd.h"
+#include "video_core/pica_types.h"
+
+namespace Memory {
+class MemorySystem;
+}
+
+namespace Pica {
+class PicaCore;
+}
+
+namespace VideoCore {
+
+class RasterizerInterface;
+class RendererBase;
+
+/// Target display rate in frames per second; 0 disables interpolation (the game's own rate).
+/// Must be set before the GPU is created.
+void SetDisplayRate(double fps);
+double GetDisplayRate();
+
+class FrameInterpolator {
+public:
+    FrameInterpolator(Pica::PicaCore& pica, Memory::MemorySystem& memory);
+    ~FrameInterpolator();
+
+    /// Forget all recorded frames (when interpolation is turned back on).
+    void Reset();
+
+    // ---- Recording (called by the GPU while the game runs) ----------------------------------
+
+    void RecordFill(u32 index, const Pica::MemoryFillConfig& config);
+    void RecordTransfer(const Pica::DisplayTransferConfig& config);
+    void RecordCmdList(PAddr addr, u32 size);
+    /// A command list segment was read (the first one, or a chained one).
+    void RecordWords(PAddr addr, const u8* data, u32 size);
+    /// A draw was triggered: snapshot what it reads and its uniforms.
+    void RecordDraw(bool is_indexed);
+    /// The game swapped the top screen's framebuffer: the frame is complete.
+    void EndFrame(u64 ticks);
+
+    // ---- Replay (called by the PICA core while a frame is replayed) --------------------------
+
+    /// Command list words for a replayed list (from the recording, not from game memory).
+    const u8* ReplayWords(PAddr addr, u32 size);
+    void BeginReplayDraw();
+    void EndReplayDraw();
+
+    /// Render and present the frame for emulated time `now_ticks`.
+    void Present(u64 now_ticks, RasterizerInterface& rasterizer, RendererBase& renderer);
+
+private:
+    struct Op {
+        enum class Type : u8 { Fill, Transfer, CmdList } type;
+        u32 index;
+        PAddr addr;
+        u32 size;
+        std::array<u32, 12> config;
+    };
+    struct Range {
+        PAddr addr;
+        u32 size;
+        u32 blob_offset;
+    };
+    struct Draw {
+        u64 key;
+        std::array<Common::Vec4<Pica::f24>, 96> f;
+        u32 first_range;
+        u32 num_ranges;
+    };
+    struct Segment {
+        PAddr addr;
+        u32 size;
+        u32 blob_offset;
+    };
+    struct Frame {
+        std::string start_state;
+        std::vector<Op> ops;
+        std::vector<Draw> draws;
+        std::vector<Range> ranges;
+        std::vector<Segment> segments;
+        std::vector<u8> blob;
+        std::array<Pica::FramebufferConfig, 2> framebuffer_config;
+        Pica::RegsLcd regs_lcd;
+        std::vector<PAddr> transfer_outputs;
+        u64 end_ticks = 0;
+        u64 serial = 0;
+        bool started = false;
+
+        void Clear();
+    };
+    enum class Blend : u8 { Same, Lerp };
+
+    void BeginFrameIfNeeded();
+    void MatchFrames();
+    void Replay(const Frame& frame, float t, RasterizerInterface& rasterizer);
+    u32 AddBlob(const u8* data, u32 size);
+
+    Pica::PicaCore& pica;
+    Memory::MemorySystem& memory;
+
+    Frame recording;
+    Frame frames[2];       // frames[1] is the newest complete frame, frames[0] the one before
+    u64 next_serial = 1;
+
+    // Per draw of frames[1]: index of the matching draw in frames[0] (or -1) and how to blend
+    std::vector<s32> match;
+    std::vector<Blend> blend;
+    bool cut = false;
+
+    // Replay state
+    const Frame* replaying = nullptr;
+    float replay_t = 1.0f;
+    u32 replay_draw = 0;
+    u32 replay_segment = 0;
+    std::vector<std::pair<u8*, std::vector<u8>>> overlay; // memory to restore after a draw
+    std::array<Common::Vec4<Pica::f24>, 96> saved_uniforms;
+    bool uniforms_overridden = false;
+
+    u64 last_serial = 0;
+    u64 debug_counter = 0;
+    u64 replay_us = 0, replays = 0;
+    float last_t = -1.0f;
+};
+
+} // namespace VideoCore
