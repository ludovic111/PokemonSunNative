diff --git a/src/core/arm/external_cpu.h b/src/core/arm/external_cpu.h
new file mode 100644
index 000000000..a223f89f2
--- /dev/null
+++ b/src/core/arm/external_cpu.h
@@ -0,0 +1,38 @@
+// Copyright 2026 PokemonSunNative contributors
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+// Hooks that let a frontend supply its own CPU backend (PokemonSunNative's ahead-of-time
+// translated code) and learn when code modules are loaded.
+
+#pragma once
+
+#include <functional>
+#include <memory>
+#include <string>
+#include "common/common_types.h"
+#include "core/core_timing.h"
+
+namespace Memory {
+class MemorySystem;
+}
+
+namespace Core {
+
+class ARM_Interface;
+class System;
+
+struct ExternalCpu {
+    /// When set, System::Init creates CPU cores with this instead of dynarmic / dyncom.
+    std::function<std::shared_ptr<ARM_Interface>(System&, Memory::MemorySystem&, u32 core_id,
+                                                 std::shared_ptr<Timing::Timer>)>
+        factory;
+    /// Called after ldr:ro has loaded and relocated a CRO module.
+    std::function<void(const std::string& name, VAddr address, u32 size)> on_cro_loaded;
+    /// Called before ldr:ro unloads a CRO module.
+    std::function<void(const std::string& name, VAddr address)> on_cro_unloaded;
+};
+
+ExternalCpu& GetExternalCpu();
+
+} // namespace Core
